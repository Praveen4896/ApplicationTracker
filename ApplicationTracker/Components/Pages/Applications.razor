@page "/applications"
@inject ApplicationTracker.Data.ApplicationService Service
@inject NavigationManager Navigation

<PageTitle>Applications | Application Tracker</PageTitle>

<header class="page-header compact">
    <div><p class="eyebrow">JOB SEARCH</p><h1>Applications</h1><p>Everything you applied for, with the exact documents you used.</p></div>
    <a class="button primary" href="applications/new">＋ Add application</a>
</header>

<section class="panel">
    <div class="filters">
        <input @bind="search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Search company, position, location, job ID, or description…" />
        <select @bind="status" @bind:after="LoadAsync">
            <option value="">All statuses</option>
            @foreach (var value in Enum.GetValues<ApplicationStatus>()) { <option value="@value">@value</option> }
        </select>
    </div>
    @if (items is null)
    {
        <p>Loading…</p>
    }
    else if (items.Count == 0)
    {
        <div class="empty"><span>▤</span><h3>No matching applications</h3><p>Add a new application or change your filters.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="applications-table">
                <colgroup>
                    <col class="company-col" />
                    <col class="applied-col" />
                    <col class="status-col" />
                    <col class="resume-col" />
                    <col class="actions-col" />
                </colgroup>

                <thead>
                    <tr>
                        <th>Company & position</th>
                        <th>Applied</th>
                        <th>Status</th>
                        <th>Resume</th>
                        <th></th>
                    </tr>
                </thead>
            <tbody>
            @foreach (var item in items)
            {
                        <tr>
                            <td>
                                <a class="application-link"
                                   href="applications/@item.Id"
                                   title="View application details">

                                    <strong>@item.CompanyName</strong>

                                    <small>
                                        @item.PositionTitle
                                        @(!string.IsNullOrWhiteSpace(item.Location)
                                            ? $" · {item.Location}"
                                            : "")
                                    </small>
                                </a>
                            </td>

                            <td class="applied-column">
                                @item.AppliedDate.ToString("MMM d, yyyy")
                            </td>

                            <td class="status-column">
                                <select class="status-select status-@item.Status.ToString().ToLower()"
                                        value="@item.Status"
                                        disabled="@updatingApplicationIds.Contains(item.Id)"
                                        @onchange="eventArgs => UpdateStatusAsync(
                                                                item,
                                                                eventArgs.Value?.ToString())">

            @foreach (var applicationStatus in Enum.GetValues<ApplicationStatus>())
                                    {
                                        <option value="@applicationStatus">
                                            @applicationStatus
                                        </option>
                                    }
                                </select>
                            </td>

                            <td class="resume-column">
                                @if (!string.IsNullOrWhiteSpace(item.ResumeFileName))
                                {
                                    <span class="resume-file-name"
                                          title="@item.ResumeFileName">
                                        @item.ResumeFileName
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>

                            <td class="actions">
                                <a href="applications/@item.Id/edit">
                                    Edit
                                </a>

                                @if (!string.IsNullOrWhiteSpace(item.JobPostingUrl))
                                {
                                    <a href="@item.JobPostingUrl"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Open Job ↗
                                    </a>
                                }
                            </td>
                        </tr>
            }
            </tbody>
        </table></div>
    }
</section>

@code {
    private List<JobApplication>? items;
    private string search = string.Empty;
    private string status = string.Empty;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        ApplicationStatus? parsed = Enum.TryParse<ApplicationStatus>(status, out var value) ? value : null;
        items = await Service.GetAllAsync(search, parsed);
    }

    private readonly HashSet<int> updatingApplicationIds = new();

    private async Task UpdateStatusAsync(
        JobApplication application,
        string? selectedStatus)
    {
        if (!Enum.TryParse<ApplicationStatus>(
                selectedStatus,
                true,
                out var newStatus))
        {
            return;
        }

        if (application.Status == newStatus)
        {
            return;
        }

        var previousStatus =
            application.Status;

        application.Status =
            newStatus;

        updatingApplicationIds.Add(
            application.Id);

        try
        {
            var updated =
                await Service.UpdateStatusAsync(
                    application.Id,
                    newStatus);

            if (!updated)
            {
                application.Status =
                    previousStatus;
            }
        }
        catch
        {
            application.Status =
                previousStatus;
        }
        finally
        {
            updatingApplicationIds.Remove(
                application.Id);
        }
    }
}
