@page "/discover"
@using ApplicationTracker.Services
@inject JobDiscoveryState SearchState
@inject JobCaptureStore CaptureStore
@inject NavigationManager Navigation

<PageTitle>Discover Jobs | Application Tracker</PageTitle>

<header class="page-header compact">
    <div>
        <p class="eyebrow">JOB DISCOVERY</p>
        <h1>Discover jobs</h1>
        <p>Search verified, direct employer and public ATS job postings.</p>
    </div>
</header>

<section class="panel discovery-search-panel"
         aria-busy="@(SearchState.IsFiltering || SearchState.IsLoadingCatalog)">
    <div class="discovery-primary-search">
        <label>
            <span>Job title, skill, or company</span>
            <input @bind="SearchState.Keyword"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder=".NET developer, software engineer, data scientist…" />
        </label>

        <label>
            <span>Location</span>
            <input @bind="SearchState.Location"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Remote, Texas, New York…" />
        </label>

        <button type="button"
                class="button primary"
                disabled="@SearchIsBusy"
                @onclick="SearchAsync">
            @SearchButtonText
        </button>
    </div>

    <div class="discovery-filter-grid">
        <label>
            <span>Date posted</span>
            <select @bind="SearchState.PostedWithinValue">
                <option value="">Any time</option>
                <option value="1">Last 24 hours</option>
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
            </select>
        </label>

        <label>
            <span>Employment type</span>
            <select @bind="SearchState.EmploymentType">
                <option value="">All types</option>
                <option value="Full time">Full time</option>
                <option value="Part time">Part time</option>
                <option value="Contract">Contract</option>
                <option value="Internship">Internship</option>
            </select>
        </label>

        <label>
            <span>Work model</span>
            <select @bind="SearchState.WorkplaceType">
                <option value="">All work models</option>
                <option value="Remote">Remote</option>
                <option value="Hybrid">Hybrid</option>
                <option value="On-site">On-site</option>
            </select>
        </label>

        <label>
            <span>Sort by</span>
            <select @bind="SearchState.SortOrder">
                <option value="newest">Newest first</option>
                <option value="relevance">Most relevant</option>
                <option value="company">Company</option>
                <option value="title">Job title</option>
            </select>
        </label>

        <label class="discovery-us-filter">
            <input type="checkbox" @bind="SearchState.UnitedStatesOnly" />
            <span>United States only</span>
        </label>
    </div>

    <div class="discovery-selection-row">
        <div class="discovery-filter-field">
            <span class="discovery-filter-label">Experience levels</span>

            <details class="discovery-multiselect">
                <summary>@ExperienceSummary</summary>

                <div class="discovery-multiselect-menu">
                    @foreach (var level in availableExperienceLevels)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@SearchState.SelectedExperienceLevels.Contains(level)"
                                   @onchange="eventArgs => ToggleExperienceLevel(level, eventArgs.Value)" />
                            <span>@level</span>
                        </label>
                    }
                </div>
            </details>
        </div>

        <div class="discovery-selected-summary" aria-live="polite">
            @if (SearchState.SelectedExperienceLevels.Count > 0)
            {
                @foreach (var level in OrderedSelectedExperienceLevels)
                {
                    <button type="button"
                            class="discovery-removable-chip"
                            title="Remove @level"
                            @onclick="() => RemoveExperienceLevel(level)">
                        @level <span aria-hidden="true">×</span>
                    </button>
                }
            }
            else
            {
                <span>All experience levels</span>
            }
        </div>
    </div>

    <fieldset class="discovery-skills">
        <legend>Skills — select one or more, then choose Search jobs</legend>

        @foreach (var skill in availableSkills)
        {
            <label class="skill-filter @(SearchState.SelectedSkills.Contains(skill) ? "selected" : string.Empty)">
                <input type="checkbox"
                       checked="@SearchState.SelectedSkills.Contains(skill)"
                       @onchange="eventArgs => ToggleSkill(skill, eventArgs.Value)" />
                <span>@skill</span>
            </label>
        }
    </fieldset>

    <div class="discovery-filter-actions">
        <span class="discovery-filter-hint">
            Filter selections are kept when you visit another page.
        </span>

        <button type="button"
                class="discovery-clear-button"
                disabled="@SearchIsBusy"
                @onclick="ClearFiltersAsync">
            Clear all filters
        </button>
    </div>
</section>

@if (SearchState.IsFiltering)
{
    <div class="discovery-search-status" role="status" aria-live="assertive">
        <span class="discovery-spinner" aria-hidden="true"></span>
        <span>
            <strong>Searching your cached job catalog…</strong>
            <small>No employer sites are being downloaded again.</small>
        </span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(SearchState.ErrorMessage))
{
    <section class="panel discovery-message error">
        @SearchState.ErrorMessage
    </section>
}

@if (SearchState.Warnings.Count > 0)
{
    <details class="panel discovery-warning">
        <summary>
            @SearchState.Warnings.Count source(s) could not be loaded. Other sources are still shown.
        </summary>

        @foreach (var warning in SearchState.Warnings)
        {
            <p>@warning</p>
        }
    </details>
}

@if (SearchState.IsLoadingCatalog && !SearchState.IsCatalogLoaded)
{
    <section class="panel empty discovery-loading" role="status" aria-live="polite">
        <span class="discovery-spinner discovery-spinner-large" aria-hidden="true"></span>
        <h3>Loading current job postings…</h3>
        <p>The first load checks the configured sources. Later searches use the cached catalog.</p>
    </section>
}
else if (SearchState.IsCatalogLoaded && SearchState.TotalCount == 0)
{
    <section class="panel empty">
        <span>⌕</span>
        <h3>No matching jobs found</h3>
        <p>Try a broader keyword, remove a skill, or change the date and location filters.</p>
    </section>
}
else if (SearchState.CurrentJobs.Count > 0)
{
    <section class="discovery-results-container">
        <div class="discovery-results @(SearchState.IsFiltering ? "is-updating" : string.Empty)">
            <div class="discovery-results-header">
                <div>
                    <h2>@SearchState.TotalCount matching job(s)</h2>
                    <span>
                        Showing @FirstResultNumber–@LastResultNumber from
                        @SearchState.SuccessfulSourceCount of @SearchState.SourceCount available sources
                    </span>
                </div>

                <span>@SearchState.AllJobsLoaded active postings checked</span>
            </div>

            @foreach (var job in SearchState.CurrentJobs)
            {
                <article class="panel discovered-job-card" @key="job.JobPostingUrl">
                    <div class="discovered-job-main">
                        <div class="discovered-job-heading">
                            <div>
                                <h2>@job.PositionTitle</h2>
                                <strong>@job.CompanyName</strong>
                            </div>

                            @if (job.PostedDate.HasValue)
                            {
                                <time title="The date is supplied by the employer's ATS.">
                                    Posted @job.PostedDate.Value.ToString("MMM d, yyyy")
                                </time>
                            }
                            else
                            {
                                <time>Date unavailable</time>
                            }
                        </div>

                        <div class="discovered-job-facts">
                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <span>⌖ @job.Location</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.WorkplaceType))
                            {
                                <span>@job.WorkplaceType</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                            {
                                <span>@job.EmploymentType</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.Department))
                            {
                                <span>@job.Department</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.ExperienceLevel))
                            {
                                <span>@job.ExperienceLevel</span>
                            }

                            <span>@job.Source</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(job.JobDescription))
                        {
                            <p class="discovered-job-description">
                                @ShortDescription(job.JobDescription)
                            </p>
                        }
                    </div>

                    <div class="discovered-job-actions">
                        <button type="button"
                                class="button primary"
                                @onclick="() => TrackJob(job)">
                            Track application
                        </button>

                        <a class="button secondary"
                           href="@job.ApplyUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            Open job ↗
                        </a>
                    </div>
                </article>
            }

            @if (SearchState.TotalPages > 1)
            {
                <nav class="discovery-pagination" aria-label="Job search result pages">
                    <button type="button"
                            class="button secondary"
                            disabled="@(SearchState.CurrentPage <= 1)"
                            @onclick="PreviousPage">
                        ← Previous
                    </button>

                    <div class="discovery-page-numbers">
                        @{ var previousVisiblePage = 0; }

                        @foreach (var pageNumber in GetVisiblePageNumbers())
                        {
                            @if (previousVisiblePage > 0
                                && pageNumber - previousVisiblePage > 1)
                            {
                                <span class="discovery-page-ellipsis">…</span>
                            }

                            <button type="button"
                                    class="discovery-page-button @(pageNumber == SearchState.CurrentPage ? "active" : string.Empty)"
                                    aria-current="@(pageNumber == SearchState.CurrentPage ? "page" : null)"
                                    @onclick="() => GoToPage(pageNumber)">
                                @pageNumber
                            </button>

                                previousVisiblePage = pageNumber;
                        }
                    </div>

                    <button type="button"
                            class="button secondary"
                            disabled="@(SearchState.CurrentPage >= SearchState.TotalPages)"
                            @onclick="NextPage">
                        Next →
                    </button>
                </nav>
            }
        </div>
    </section>
}

@code {
    private readonly string[] availableSkills =
    {
        ".NET", "C#", "Java", "Python", "JavaScript", "TypeScript",
        "React", "Angular", "SQL", "Azure", "AWS", "Docker", "Kubernetes"
    };

    private readonly string[] availableExperienceLevels =
    {
        "Internship", "Entry level", "Mid level", "Senior",
        "Lead / Principal", "Manager", "Not specified"
    };

    private bool SearchIsBusy =>
        SearchState.IsLoadingCatalog || SearchState.IsFiltering;

    private string SearchButtonText => SearchState.IsLoadingCatalog
        ? "Loading jobs…"
        : SearchState.IsFiltering
            ? "Searching…"
            : "Search jobs";

    private string ExperienceSummary => SearchState.SelectedExperienceLevels.Count switch
    {
        0 => "All experience levels",
        1 => SearchState.SelectedExperienceLevels.First(),
        var count => $"{count} levels selected"
    };

    private IEnumerable<string> OrderedSelectedExperienceLevels =>
        availableExperienceLevels.Where(SearchState.SelectedExperienceLevels.Contains);

    private int FirstResultNumber => SearchState.TotalCount == 0
        ? 0
        : ((SearchState.CurrentPage - 1) * SearchState.PageSize) + 1;

    private int LastResultNumber =>
        Math.Min(SearchState.CurrentPage * SearchState.PageSize, SearchState.TotalCount);

    protected override async Task OnInitializedAsync()
    {
        await SearchState.EnsureCatalogLoadedAsync();
    }

    private async Task SearchAsync()
    {
        var searchTask = SearchState.ApplyFiltersAsync();
        await InvokeAsync(StateHasChanged);
        await searchTask;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearFiltersAsync()
    {
        SearchState.ClearFilters();
        await SearchAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && !SearchIsBusy)
        {
            await SearchAsync();
        }
    }

    private void ToggleSkill(string skill, object? value)
    {
        SetSelectedValue(SearchState.SelectedSkills, skill, IsChecked(value));
    }

    private void ToggleExperienceLevel(string level, object? value)
    {
        SetSelectedValue(
            SearchState.SelectedExperienceLevels,
            level,
            IsChecked(value));
    }

    private void RemoveExperienceLevel(string level)
    {
        SearchState.SelectedExperienceLevels.Remove(level);
    }

    private static bool IsChecked(object? value) =>
        value is bool isChecked && isChecked;

    private static void SetSelectedValue(
        HashSet<string> selectedValues,
        string value,
        bool isSelected)
    {
        if (isSelected)
        {
            selectedValues.Add(value);
        }
        else
        {
            selectedValues.Remove(value);
        }
    }

    private void GoToPage(int pageNumber)
    {
        SearchState.GoToPage(pageNumber);
    }

    private void PreviousPage()
    {
        GoToPage(SearchState.CurrentPage - 1);
    }

    private void NextPage()
    {
        GoToPage(SearchState.CurrentPage + 1);
    }

    private IReadOnlyList<int> GetVisiblePageNumbers()
    {
        var pages = new SortedSet<int> { 1, SearchState.TotalPages };

        for (var page = SearchState.CurrentPage - 2;
             page <= SearchState.CurrentPage + 2;
             page++)
        {
            if (page >= 1 && page <= SearchState.TotalPages)
            {
                pages.Add(page);
            }
        }

        return pages.ToList();
    }

    private void TrackJob(DiscoveredJobResult job)
    {
        var token = CaptureStore.Add(new JobCaptureRequest
        {
            Url = job.JobPostingUrl,
            PageTitle = job.PositionTitle,
            PositionTitle = job.PositionTitle,
            CompanyName = job.CompanyName,
            Location = job.Location,
            JobId = job.ExternalJobId,
            Source = $"{job.Source} - {job.CompanyName}",
            RenderedText = job.JobDescription,
            CapturedAtUtc = DateTime.UtcNow
        });

        Navigation.NavigateTo(
            "/applications/new"
            + $"?captureToken={Uri.EscapeDataString(token)}");
    }

    private static string ShortDescription(string description)
    {
        const int maximumLength = 420;

        return description.Length <= maximumLength
            ? description
            : description[..maximumLength].Trim() + "…";
    }
}
